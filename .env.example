# =============================================================================
# OMOP Concept Automapper - configuration
# Copy to .env and adjust. Every variable has a sensible default unless marked REQUIRED.
#
# This file is read by the backend and worker (and interpolated into docker-compose.yaml).
# LLM provider API keys do NOT belong here: put them in .env.litellm (see .env.litellm.example),
# which only the LiteLLM proxy container reads.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# prod refuses to start with placeholder or weak secrets (JWT_SECRET shorter than 32 characters,
# default ADMIN_PASSWORD, POSTGRES_PASSWORD or LITELLM_MASTER_KEY); dev/test allow them
APP_ENV=prod
LOG_LEVEL=INFO
# json (production) or text (development)
LOG_FORMAT=json
# Browser origins allowed to call the API directly (the bundled nginx frontend is same-origin)
CORS_ORIGINS=http://localhost:8501,http://localhost:5173
# Host port (and interface) of the web UI. Use FRONTEND_BIND=127.0.0.1 behind a reverse proxy on the same host.
FRONTEND_PORT=8501
FRONTEND_BIND=0.0.0.0
# Subnet of the compose network. The backend trusts X-Forwarded-For only from it (i.e. from nginx).
# Change it if it collides with another network on the host.
APP_SUBNET=172.29.250.0/24

# --- PostgreSQL (REQUIRED) ---------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED in prod: a strong password (the placeholder below is refused)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auto_mapper
# Overridden to the compose service name inside containers
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
# Optional full SQLAlchemy URL; takes precedence over the POSTGRES_* values
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# PostgreSQL server tuning (see docker-compose.yaml); size to the host's RAM
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=32MB
# DiskANN index builds use maintenance_work_mem
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_WAL_SIZE=4GB
PG_MAX_CONNECTIONS=200
PG_SHM_SIZE=1g

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Defaults: Redis DB 1 (broker) and DB 2 (results) on REDIS_URL
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# Parallel background tasks per worker container
CELERY_CONCURRENCY=2
# Seconds that cached read endpoints (stats, status) stay cached
CACHE_TTL_SECONDS=60

# --- Authentication (REQUIRED in prod) ---------------------------------------
# Long random string, at least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
COOKIE_NAME=omop_session
# Send the session cookie only over HTTPS. Unset = true when APP_ENV=prod, false otherwise, so in
# production serve the UI through a TLS-terminating proxy (see README). Set false only to test
# a prod build over plain http://localhost.
# COOKIE_SECURE=true
# Initial admin, created on first start if no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Failed logins per username+IP before a temporary lockout
LOGIN_MAX_FAILURES=5
# Failed logins per username from any address (stops guessing spread over many IPs)
LOGIN_MAX_FAILURES_PER_USER=20
LOGIN_LOCKOUT_SECONDS=900

# --- LLM provider (LiteLLM proxy) --------------------------------------------
# Switching provider = changing the model names below and adding that provider's key.
# Model names use LiteLLM's "<provider>/<model>" form. Defaults (accurate mid-tier models,
# November 2026; see README "Providers and default models"):
LLM_CHAT_MODEL=anthropic/claude-sonnet-5-5
LLM_EMBEDDING_MODEL=gemini/gemini-embedding-2
# Requested embedding size; leave empty to use the model's native size.
# Changing model or dims switches to a different embedding collection (which must be embedded).
EMBEDDING_DIMS=1536
# Text embedded per concept: name | name_context | name_synonyms | name_context_synonyms
# (synonyms need CONCEPT_SYNONYM.csv). Each choice is its own collection.
EMBEDDING_TEXT=name_synonyms
# Send query/document task types (Gemini task_type, Voyage/Cohere input_type)
EMBEDDING_TASK_TYPES=true
# After a vocabulary import, re-embed concepts whose text changed and embed new concepts in
# domains the active collection already covers (costs embedding calls)
AUTO_EMBED_AFTER_VOCABULARY_IMPORT=true
# Parallel requests and texts per request when embedding concepts (lower the concurrency for
# a free tier; empty request size = provider default)
EMBEDDING_CONCURRENCY=4
EMBEDDING_REQUEST_SIZE=
# Alternatives (reranker LLM / embedding model):
#   One provider, OpenAI:   openai/gpt-6.1-terra           openai/text-embedding-3-large
#   One provider, Google:   gemini/gemini-4-hydrogen        gemini/gemini-embedding-2
#   EU provider, Mistral:   mistral/mistral-large-latest   mistral/mistral-embed (EMBEDDING_DIMS=1024)
#   Budget:                 anthropic/claude-haiku-5-5 or openai/gpt-6-luna
#   Local, Ollama:          ollama/mistral-small           ollama/bge-m3 (EMBEDDING_DIMS=1024, + OLLAMA_API_BASE)
#   Azure / Vertex / Bedrock (EU regions): add a deployment entry in litellm/config.yaml

# Provider keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...) go in .env.litellm, not here.

# Key the app uses to call the proxy (any long secret string; the proxy enforces it).
# REQUIRED in prod; compose passes it to the litellm container too. E.g. `echo sk-$(openssl rand -hex 24)`
LITELLM_MASTER_KEY=sk-litellm-change-me
# Proxy address (inside compose: http://litellm:4000)
LLM_GATEWAY_URL=http://litellm:4000

# Choices offered on the Settings page (listed first). The gateway's own model list is merged in:
# each provider wildcard route in litellm/config.yaml lists that provider's models.
LLM_MODEL_OPTIONS=anthropic/claude-sonnet-5-5,openai/gpt-6.1-terra,gemini/gemini-4-hydrogen,mistral/mistral-large-latest,anthropic/claude-haiku-5-5,openai/gpt-6-luna,ollama/mistral-small
# "model:max_dims" pairs
EMBEDDING_MODEL_OPTIONS=gemini/gemini-embedding-2:3072,voyage/voyage-4-large:2048,cohere/embed-v5.0-pro:1536,openai/text-embedding-3-large:3072,mistral/mistral-embed:1024,ollama/bge-m3:1024

# Sampling temperature for the reranker/agents (default 0: repeatable mapping decisions).
# Models that reject a temperature (reasoning models such as gpt-5) are not a problem: the
# LiteLLM proxy drops unsupported parameters (drop_params: true in litellm/config.yaml).
# Leave empty to not send a temperature at all (provider default).
LLM_TEMPERATURE=0
# Instructor re-asks after validation errors (e.g. an out-of-range candidate id)
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=3
# Instructor structured-output mode: tools (default), json, json_schema, md_json
INSTRUCTOR_MODE=tools
# Per-model exceptions, "<model name prefix>=<mode>" (Claude via OpenRouter rejects forced tool use)
INSTRUCTOR_MODE_OVERRIDES=openrouter/anthropic/=json_schema
# Seconds query embeddings stay cached in Redis
QUERY_EMBEDDING_CACHE_TTL=604800
# Reuse the reranker's answer for an identical prompt and model, in seconds (0 = never)
LLM_CACHE_TTL=2592000

# --- Auto-mapping workflows --------------------------------------------------
# Default pipeline: automap (rerank + threshold) or automap_refine (+ agent retry)
AUTOMAP_PIPELINE=automap
# Concepts processed in parallel by one auto-map task
AUTOMAP_CONCURRENCY=4
# Rerank cascade (optional): two or more models pick independently; when they agree their pick
# stands, otherwise RERANK_JUDGE (empty = the configured LLM model) decides, seeing their picks.
# Judge decisions are marked "[voters disagreed, judge decided]" in the rationale. Example:
# RERANK_VOTERS=openrouter/anthropic/claude-haiku-5.5,openrouter/openai/gpt-oss-120b
# RERANK_JUDGE=openrouter/anthropic/claude-sonnet-5.5
RERANK_VOTERS=
RERANK_JUDGE=
# Comma-separated plugin modules registering extra workflow steps, e.g.
# WORKFLOW_PLUGINS=examples.workflow_plugins.translate_query.nodes
WORKFLOW_PLUGINS=
# Comma-separated directories with extra pipeline YAML files, e.g.
# WORKFLOW_DEFINITIONS_DIR=/app/examples/workflow_plugins/translate_query
WORKFLOW_DEFINITIONS_DIR=

# --- Vector search (pgvectorscale DiskANN) -----------------------------------
DISKANN_QUERY_RESCORE=100
DISKANN_QUERY_SEARCH_LIST_SIZE=200
# Embedding runs larger than this drop and rebuild the index (faster bulk loads)
DISKANN_REBUILD_THRESHOLD=10000
# maintenance_work_mem used while building the DiskANN index (keep below the container's RAM)
DISKANN_MAINTENANCE_WORK_MEM=1GB

# --- Files ---------------------------------------------------------------------
# Container paths; ./vocabulary on the host is mounted at VOCABULARY_DIR
VOCABULARY_DIR=/data/vocabulary
UPLOAD_DIR=/data/uploads
