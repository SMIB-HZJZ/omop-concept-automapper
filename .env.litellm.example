# =============================================================================
# LLM provider keys - read ONLY by the LiteLLM proxy container.
# Copy to .env.litellm and set the keys of the providers you use.
# (LITELLM_MASTER_KEY lives in .env; compose passes it to the proxy.)
# =============================================================================
# Default models (see .env): Claude Sonnet 5.5 for reranking/translation (Opus 5.5 for unsure terms,
# Haiku 5.5 for explanations), OpenAI text-embedding-3-large for search.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Other cloud providers (set only the ones you use)
# GEMINI_API_KEY=
# MISTRAL_API_KEY=      # EU-based provider
# VOYAGE_API_KEY=       # embeddings
# COHERE_API_KEY=       # embeddings
# OPENROUTER_API_KEY=   # one key for many providers, incl. open-weight models (Qwen3 Embedding, BGE-M3)
# AZURE_API_KEY=        # Azure OpenAI also needs a deployment entry in litellm/config.yaml
# AZURE_API_BASE=
# AZURE_API_VERSION=

# Local models: no data leaves your network (Ollama running on the host or another server)
# OLLAMA_API_BASE=http://host.docker.internal:11434
